{
  "name": "@purrroute/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "migrate": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir ../../db/migrations",
    "migrate:down": "node --env-file-if-exists=.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir ../../db/migrations"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/rate-limit": "11.2.1",
    "@purrroute/contracts": "0.0.0",
    "@purrroute/domain": "0.0.0",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0"
  }
}
